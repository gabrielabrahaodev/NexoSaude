rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES DE SEGURANÇA ---
    // Modelo (reavaliação 16/10): sem poder global de owner. Owner age SÓ
    // na própria clínica (ownsClinic) ou na equipe dela (team-manage);
    // plataforma = superadmin. Listas são tudo-ou-nada: restrição que a
    // query não prova nega a LISTA inteira (nunca filtrar via lista).

    // Verifica se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Papel owner (plataforma antiga: Dra. Lauciele). NÃO usar sozinho
    // como autorização de dados de clínica (global). Uso restante: casos
    // sem clinicId (ex.: password_reset sem clínica) + telas owner-only.
    function isOwner() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // 1b. Dono da plataforma (Master): gerencia owners, clínicas e débitos.
    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // 1c. Dono do débito da plataforma (owner da assinatura).
    function isPlatformDebtor(resource) {
      return isAuthenticated() &&
             resource.data.ownerId == request.auth.uid;
    }

    // 1d. Doc do atualizador (com guarda: sem doc = mapa vazio).
    function _updater() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && exists(p)
        ? get(p).data
        : {'role': '', 'allowedClinics': [], 'status': ''};
    }

    function _updaterRole() {
      return _updater().get('role', '');
    }

    function _updaterClinics() {
      let c = _updater().get('allowedClinics', []);
      return c is list ? c : [];
    }

    // 1e. Perfil ATIVO (reavaliação P1): pendente/desativado não opera —
    // perde acesso operacional mesmo com `allowedClinics` antigo. Login
    // barra pendente antes do dashboard (role_check_screen).
    function _isActiveUser() {
      return isAuthenticated() &&
        _updater().get('status', '') == 'Ativo';
    }

    // 2. Verifica se a funcionária ATIVA tem permissão para a clínica
    function hasClinicAccess(clinicId) {
      return _isActiveUser() &&
             clinicId is string && clinicId != '' &&
             _updaterClinics().hasAny([clinicId]);
    }

    // 2b. Dono DAQUELA clínica (ownerId) — não basta ser owner em geral.
    function ownsClinic(clinicId) {
      return isAuthenticated() &&
             clinicId is string && clinicId != '' &&
             exists(/databases/$(database)/documents/clinics/$(clinicId)) &&
             get(/databases/$(database)/documents/clinics/$(clinicId)).data.ownerId == request.auth.uid;
    }

    // 2c. Clínica ATIVA (trava de assinatura enforceable no servidor,
    // reavaliação §3): bloqueada pelo Master OU trial vencido = sem acesso
    // operacional (staff e owner; superadmin passa direto). Sem trialEndsAt
    // = ativa (legadas + 2ª unidade criada no app; migração: backfill).
    function clinicActive(clinicId) {
      let c = get(/databases/$(database)/documents/clinics/$(clinicId));
      let trial = c.data.get('trialEndsAt', null);
      return c.data.get('blockedByAdmin', false) != true &&
        (trial == null || trial > request.time);
    }

    // 2d. Acesso operacional a UMA clínica: plataforma, ou (dono dela ou
    // staff dela) COM a clínica ativa. Custo: gets extras por avaliação;
    // base pequena (mono-digit clínicas) — aceito e documentado.
    function clinicScoped(clinicId) {
      return isSuperAdmin() ||
        (_isActiveUser() &&
         (hasClinicAccess(clinicId) || ownsClinic(clinicId)) &&
         clinicActive(clinicId));
    }

    // 2e. Mesma clínica entre usuários: SÓ para leituras por doc (get) de
    // perfis ATIVOS. NUNCA em LISTAS (tudo-ou-nada nega a query inteira).
    function sharesClinic(targetAllowed) {
      return _isActiveUser() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             targetAllowed is list &&
             _updaterClinics().hasAny(targetAllowed);
    }

    // 2f. Clínica do paciente pai (subcoleções sem clinicId próprio).
    function patientClinicOk(patientId) {
      let pref = /databases/$(database)/documents/patients/$(patientId);
      return exists(pref) &&
             clinicScoped(get(pref).data.clinicId);
    }

    // 2g. clinicId efetivo p/ update/delete (cura legados sem o campo: vale
    // o novo quando o antigo não existe; doc sem nenhum = negado).
    function _docClinic(oldData, newData) {
      return oldData.get('clinicId', newData.get('clinicId', ''));
    }

    // 3. Caminho de segredos dentro de settings (ex.: integrations/cloudinary)
    function isSecretsPath(document) {
      return document == 'integrations' || document.matches('integrations/.*');
    }

    // 3b. Campos administrativos de clínica: SÓ superadmin.
    // Recebe LISTA de chaves (`.keys()` no create, `affectedKeys()` no
    // update) — passar o mapa inteiro quebra a verificação (P1).
    function _noClinicAdminKeys(keys) {
      return !keys.hasAny(['trialEndsAt', 'blockedByAdmin', 'ownerId']);
    }
    // Owner só cria unidade a partir de clínica própria ATIVA e herda
    // exatamente a mesma expiração. Sem trialEndsAt não há nova unidade:
    // primeiro regularize o backfill para não criar clínica eterna.
    function _ownerClinicCreate() {
      let mine = _updaterClinics();
      let sourceId = mine.size() > 0 ? mine[0] : '';
      let sourcePath = /databases/$(database)/documents/clinics/$(sourceId);
      return _isActiveUser() &&
        _updaterRole() == 'owner' &&
        mine.size() > 0 &&
        exists(sourcePath) &&
        get(sourcePath).data.get('ownerId', '') == request.auth.uid &&
        clinicActive(sourceId) &&
        get(sourcePath).data.get('trialEndsAt', null) is timestamp &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        request.resource.data.get('trialEndsAt', null) ==
          get(sourcePath).data.get('trialEndsAt', null) &&
        request.resource.data.get('blockedByAdmin', false) == false &&
        request.resource.data.keys().hasOnly(
          ['name', 'type', 'phone', 'address', 'ownerId', 'createdAt',
           'trialEndsAt', 'blockedByAdmin']) &&
        request.resource.data.get('name', '') is string &&
        request.resource.data.get('type', '') in
          ['dental', 'psychology', 'multi'];
    }

    // 3c. Papéis de equipe (nunca owner/superadmin via cliente).
    function _isStaffRole(role) {
      return role in ['dentista', 'dentist', 'recepcionista', 'receptionist',
        'psicologo', 'gerente'];
    }

    // --- REGRAS DE COLEÇÕES ---

    // A. USUÁRIOS (reavaliação P0-1: sem escrita global de owner; `role`
    // IMUTÁVEL via cliente — só superadmin promove; escalada p/ superadmin
    // pelo próprio doc, fechada).
    // GET escopado (próprio/superadmin/mesma clínica ativa); LIST só perfil
    // ATIVO (pendente não enumera ninguém — reavaliação P1).
    match /users/{userId} {
      allow get: if isAuthenticated() &&
          (request.auth.uid == userId || isSuperAdmin() ||
           sharesClinic(resource.data.get('allowedClinics', [])));
      allow list: if isSuperAdmin() ||
          (_isActiveUser() &&
           resource.data.get('allowedClinics', []) is list &&
           resource.data.get('allowedClinics', []).hasAny(_updaterClinics()));
      // Auto-cadastro (email/Google): o próprio uid, pendente, sem clínica,
      // sem cargo de poder, allowlist de campos de perfil.
      allow create: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['email', 'name', 'role',
            'allowedClinics', 'status', 'createdAt', 'created_at',
            'whatsapp', 'phone', 'authProvider'])
          && _isStaffRole(request.resource.data.get('role', ''))
          && request.resource.data.allowedClinics == []
          && request.resource.data.status == 'pending_approval'
          && request.resource.data.get('email', '') is string;
      // Trial com porteira: o próprio cria o doc owner PENDENTE (sem
      // clínica, sem trial). Superadmin aprova e provisiona.
      allow create: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['email', 'name', 'role',
            'allowedClinics', 'status', 'createdAt', 'created_at',
            'whatsapp', 'phone'])
          && request.resource.data.role == 'owner'
          && request.resource.data.allowedClinics == []
          && request.resource.data.status == 'pending_approval'
          && !('trialEndsAt' in request.resource.data.keys())
          && request.resource.data.get('email', '') is string;
      // Equipe (Funcionários): owner/superadmin vincula staff à PRÓPRIA
      // clínica (subconjunto das suas + exceção p/ clínica recém-criada
      // que ele own; nunca owner/superadmin como alvo).
      allow create: if _teamUserCreate();
      // Plataforma (Master provisiona owner + clínica).
      allow create: if isSuperAdmin();
      // Update: superadmin tudo; próprio SÓ perfil (cargo, clínicas e
      // status travados); gestor administra a equipe da própria clínica.
      allow update: if isSuperAdmin() || _selfProfileUpdate() || _teamUserManage();
      // Delete: SÓ plataforma, + auto-limpeza do próprio cadastro pendente
      // (falha no trial: apaga o doc órfão para tentar de novo).
      allow delete: if isSuperAdmin() ||
          (isAuthenticated() && request.auth.uid == userId &&
           resource.data.get('status', '') == 'pending_approval' &&
           resource.data.get('allowedClinics', []) == []);
    }

    // A0. Criação de vínculo de equipe pelo gestor ATIVO (ou plataforma).
    function _teamUserCreate() {
      let ur = _updaterRole();
      let mine = _updaterClinics();
      let t = request.resource.data;
      let clinics = t.get('allowedClinics', []);
      return isAuthenticated() &&
        (ur == 'superadmin' || (ur == 'owner' && _isActiveUser())) &&
        t.keys().hasOnly(['name', 'cpf', 'email', 'role', 'allowedClinics',
          'createdAt', 'created_at', 'status', 'phone', 'whatsapp']) &&
        _isStaffRole(t.get('role', '')) &&
        t.get('status', '') in ['Ativo', 'pending_approval'] &&
        t.get('email', '') is string &&
        clinics is list && clinics.size() > 0 &&
        (ur == 'superadmin' ||
         clinics.toSet().difference(mine.toSet()).size() == 0 ||
         (clinics.size() == 1 && ownsClinic(clinics[0])));
    }

    // A0b. Próprio usuário: só campos de perfil (nunca role/clínicas/
    // status — e NUNCA menuAccess: ele autoriza pixKey/gradeConfig/
    // whatsappNumber; self-grant escalava privilégio — reavaliação P1).
    function _selfProfileUpdate() {
      return isAuthenticated() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'email', 'phone', 'whatsapp', 'cpf', 'theme',
           'createdAt', 'created_at', 'authProvider',
           'updatedAt']) &&
        request.resource.data.get('role', '') ==
          resource.data.get('role', '') &&
        request.resource.data.get('allowedClinics', []) ==
          resource.data.get('allowedClinics', []) &&
        request.resource.data.get('status', '') ==
          resource.data.get('status', '');
    }

    // A0c. Gestão de equipe: owner/superadmin, alvo nunca superadmin, cargo
    // imutável, alvo da mesma clínica (ou pendente sem clínica); inclusões
    // novas restritas às clínicas do gestor + 2ª unidade recém-criada que
    // ele own (fora das suas, no máx. 1 por operação).
    function _teamUserManage() {
      let ur = _updaterRole();
      let mine = _updaterClinics();
      let old = resource.data;
      let t = request.resource.data;
      let oldClinics = old.get('allowedClinics', []);
      let newClinics = t.get('allowedClinics', []);
      let added = newClinics.toSet().difference(
        oldClinics is list ? oldClinics.toSet() : [].toSet());
      // `added` já é Set (difference retorna Set): sem toSet() aqui
      // (chamar método de lista em Set = evaluation error = nega tudo).
      let outside = added.difference(mine.toSet());
      return isAuthenticated() &&
        (ur == 'superadmin' || (ur == 'owner' && _isActiveUser())) &&
        t.keys().hasOnly(['name', 'cpf', 'email', 'role', 'allowedClinics',
          'createdAt', 'created_at', 'status', 'phone', 'whatsapp',
          'menuAccess', 'updatedAt', 'authProvider']) &&
        old.get('role', '') != 'superadmin' &&
        t.get('role', '') == old.get('role', '') &&
        newClinics is list &&
        (ur == 'superadmin' ||
         ((!(oldClinics is list) || oldClinics.size() == 0 ||
           oldClinics.toSet().hasAny(mine.toSet())) &&
          (outside.size() == 0 ||
           (outside.size() == 1 && ownsClinic(outside.toList()[0])))));
    }

    // A1b. PEDIDOS DE TRIAL (porteira do teste grátis). Create autenticado
    // (conta recém-criada) COM uid vinculado (reavaliação §4: antes o `uid`
    // era negado pela allowlist e o pedido se perdia); leitura/escrita só
    // superadmin (vê no Master e aprova pelo `uid`).
    match /trial_requests/{docId} {
      allow create: if isAuthenticated() &&
          request.resource.data.keys().hasOnly(
            ['nome', 'whatsapp', 'email', 'clinicName', 'type', 'uid',
             'status', 'createdAt']) &&
          request.resource.data.status == 'solicitado' &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.nome is string &&
          request.resource.data.nome.size() > 1 &&
          request.resource.data.nome.size() < 100 &&
          request.resource.data.whatsapp is string &&
          request.resource.data.whatsapp.size() >= 8 &&
          request.resource.data.whatsapp.size() < 20 &&
          request.resource.data.email is string &&
          request.resource.data.email.size() > 3 &&
          request.resource.data.email.size() < 100 &&
          request.resource.data.clinicName is string &&
          request.resource.data.clinicName.size() > 1 &&
          request.resource.data.clinicName.size() < 100 &&
          request.resource.data.type in ['dental', 'psychology', 'multi'];
      allow read, update, delete: if isSuperAdmin();
    }

    // A2. PREFERÊNCIAS DO USUÁRIO (ex.: tema) — o próprio ou plataforma
    // (antes: qualquer owner lia/escrevia prefs alheias).
    match /user_prefs/{uid} {
      allow read, write: if isAuthenticated() &&
          (request.auth.uid == uid || isSuperAdmin());
    }

    // A3. PEDIDOS DE RESET DE SENHA. Create PÚBLICO (deslogado, allowlist).
    // Fila interna (COM clinicId): owner ATIVO da clínica. Fila global do
    // login (SEM clinicId): SÓ plataforma (Master) — antes qualquer owner
    // lia tempPassword alheia (reavaliação P1). Temporária NUNCA persiste
    // em doc legível (reset-password.js só imprime no console).
    match /password_reset_requests/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['email', 'createdAt', 'status', 'clinicId']) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.email is string &&
          request.resource.data.email.size() > 3 &&
          request.resource.data.email.size() < 100 &&
          (!('clinicId' in request.resource.data) ||
           request.resource.data.clinicId is string);
      allow read, update, delete: if isSuperAdmin() ||
          (_isActiveUser() && _updaterRole() == 'owner' &&
           ('clinicId' in resource.data) &&
           clinicScoped(resource.data.clinicId));
    }

    // B. CLÍNICAS (reavaliação: owner NÃO escreve trial/bloqueio/dono).
    // Operacional (pixKey/gradeConfig/whatsappNumber): staff ATIVO da
    // clínica COM a flag + clínica ATIVA (trava vale aqui também).
    // LIST só perfil ATIVO (pendente não enumera; superadmin passa).
    match /clinics/{clinicId} {
      allow get: if isSuperAdmin() || (_isActiveUser() &&
          (ownsClinic(clinicId) || hasClinicAccess(clinicId)));
      allow list: if isSuperAdmin() || (_isActiveUser() &&
          (resource.data.get('ownerId', '') == request.auth.uid ||
           clinicId in _updaterClinics()));
      allow create: if isSuperAdmin() || _ownerClinicCreate();
      allow delete: if (ownsClinic(clinicId) && _isActiveUser()) ||
          isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (_isActiveUser() && ownsClinic(clinicId) && clinicActive(clinicId) &&
         _noClinicAdminKeys(
           request.resource.data.diff(resource.data).affectedKeys())) ||
        (hasClinicAccess(clinicId) && clinicActive(clinicId) &&
         _clinicOpAllowed());
    }

    function _clinicOpAllowed() {
      let affected =
        request.resource.data.diff(resource.data).affectedKeys();
      let u = _updater();
      let flags = 'menuAccess' in u && u.menuAccess is map ? u.menuAccess : {};
      // Guarda `in`: mapa sem a flag NÃO autoriza (acesso a chave
      // inexistente = evaluation error = nega tudo — P1).
      let gPix = 'g_pix' in flags && flags['g_pix'] == true;
      let gGrade = 'g_grade' in flags && flags['g_grade'] == true;
      let gClin = 'g_clinica' in flags && flags['g_clinica'] == true;
      return affected.hasOnly(
          ['pixKey', 'gradeConfig', 'whatsappNumber', 'updatedAt']) &&
        (!('pixKey' in affected) || gPix) &&
        (!('gradeConfig' in affected) || gGrade) &&
        (!('whatsappNumber' in affected) || gClin);
    }

    // B1b. PROJEÇÃO PÚBLICA p/ avaliação online (reavaliação §6): get
    // público (só nome + WhatsApp; sem listagem = sem enumeração); escrita
    // do dono/superadmin com allowlist estrita. O app espelha ao criar a
    // clínica (ver clinic_management_screen).
    match /public_clinics/{clinicId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSuperAdmin() ||
          (_isActiveUser() && ownsClinic(clinicId) && clinicActive(clinicId) &&
           request.resource.data.keys().hasOnly(
             ['name', 'whatsappNumber', 'updatedAt']) &&
           request.resource.data.get('name', '') is string);
      allow update: if request.resource.data.keys().hasOnly(
            ['name', 'whatsappNumber', 'updatedAt']) &&
          request.resource.data.get('name', '') is string &&
          (isSuperAdmin() ||
           (_isActiveUser() && ownsClinic(clinicId) && clinicActive(clinicId)) ||
           (hasClinicAccess(clinicId) && clinicActive(clinicId) &&
            _clinicOpAllowed()));
      allow delete: if isSuperAdmin() ||
          (_isActiveUser() && ownsClinic(clinicId));
    }

    // B1c. LEADS da avaliação (anônimo cria com allowlist + teto de tamanho
    // anti-spam; equipe lê). Rate limiting real exige backend (P2).
    match /public_clinics/{clinicId}/leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['answers', 'score', 'createdAt', 'origin', 'status']) &&
          request.resource.data.status == 'new_lead' &&
          request.resource.data.origin == 'web_form' &&
          request.resource.data.score is number &&
          request.resource.data.score >= 0 &&
          request.resource.data.score <= 200 &&
          request.resource.data.answers is list &&
          request.resource.data.answers.size() <= 10 &&
          request.resource.data.answers.join('|').size() < 2000;
      allow read, update, delete: if clinicScoped(clinicId);
    }

    // B1d. Leads LEGADOS em clinics/{id}/leads (tela antiga): leitura da
    // equipe p/ histórico; escrita NOVA só pela via pública (B1c).
    match /clinics/{clinicId}/leads/{leadId} {
      allow read: if isAuthenticated() && clinicScoped(clinicId);
      allow write: if false;
    }

    // B2. ASSINATURA DA PLATAFORMA (cobrança por usuário do owner).
    // platform_config/geral: {basePrice, extraPrice, pixKey}.
    match /platform_config/{docId} {
      allow read: if isSuperAdmin() ||
          (_isActiveUser() && _updaterRole() == 'owner');
      allow write: if isSuperAdmin();
    }
    match /platform_debits/{debitId} {
      allow read: if isSuperAdmin() || isPlatformDebtor(resource);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isPlatformDebtor(resource) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['avisoPagamento', 'updatedAt']));
    }

    // C. NOTÍCIAS (catálogo global, fonte = APIs externas; escrita SÓ
    // plataforma — antes qualquer owner publicava no catálogo global).
    match /news/{newsId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // D. EXCEÇÃO: CONFIRMAÇÃO VIA WHATSAPP / PORTAL (reavaliação).
    // Fonte única = token ATUAL em `patients/{patientId}.portalToken`.
    // Revogar (girar o token do paciente) INVALIDA links antigos: o token
    // copiado dentro do agendamento NÃO vale sozinho (P1). Prova SÓ
    // anônima: autenticado sem clínica usa o escopo (sem piggyback).
    // Staff SÓ com acesso à clínica. Sem token = negado (WhatsApp).
    function apptTokenOk() {
      let sent = request.resource.data.get('portalToken', '');
      let pid = resource.data.get('patientId', '');
      let pref = /databases/$(database)/documents/patients/$(pid);
      return !isAuthenticated() &&
        sent is string && sent.size() > 0 &&
        pid is string && pid != '' && exists(pref) &&
        sent == get(pref).data.get('portalToken', '');
    }
    function _apptStaff() {
      return clinicScoped(_docClinic(resource.data, request.resource.data));
    }
    match /appointments/{appointmentId} {
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status',
'confirmationDate', 'portalToken']) &&
        request.resource.data.status == 'Confirmado' &&
        (_apptStaff() || apptTokenOk());
      // Portal: pedido de remarcação (vira pendência p/ recepção).
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'proposedDate', 'portalToken']) &&
        request.resource.data.status == 'remarcar' &&
        (_apptStaff() || apptTokenOk());
    }

    // A4. PORTAL DO PACIENTE (espelhos; sem Functions).
    // portal/{token}: get público (doc opaco, só com o link); escrita
    // autenticada ESCOPADA pela clínica do espelho (cura legados sem
    // clinicId pelo campo novo); anônimo SOMENTE via allowlist (pedidos).
    // portal_slots/{clinicId}: get público (só horários livres, sem dado
    // de paciente); SEM listagem (o app/portal nunca listam); escrita
    // escopada (antes: qualquer autenticado reescrevia slots de qualquer
    // clínica).
    // O espelho só fica acessível anonimamente enquanto o token atual do
    // paciente coincidir com o token do doc e houver consentimento LGPD.
    function _portalTokenCurrent(token) {
      let pid = resource.data.get('patientId', '');
      let pref = /databases/$(database)/documents/patients/$(pid);
      return pid is string && pid != '' &&
        exists(pref) &&
        get(pref).data.get('portalToken', '') == token &&
        get(pref).data.get('lgpdPortalConsent', {}).get('accepted', false) == true;
    }
    match /portal/{token} {
      allow get: if _portalTokenCurrent(token);
      allow create: if isAuthenticated() &&
          clinicScoped(request.resource.data.get('clinicId', ''));
      allow delete: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow update: if (isAuthenticated() &&
          clinicScoped(_docClinic(resource.data, request.resource.data))) ||
        (!isAuthenticated() && _portalTokenCurrent(token) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'statusSessao', 'pedidoRemarcacao', 'avisoPagamento', 'updatedAt'
          ]));
    }
    match /portal_slots/{clinicId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAuthenticated() && clinicScoped(clinicId);
    }

    // Aviso anônimo só é aceito com o token atual do paciente vinculado
    // ao lançamento; conhecer/descobrir um financial ID não basta.
    function _financialPortalNoticeOk() {
      let pid = resource.data.get('patientId', '');
      let pref = /databases/$(database)/documents/patients/$(pid);
      let notice = request.resource.data.get('avisoPagamento', {});
      let sent = notice is map ? notice.get('portalToken', '') : '';
      return !isAuthenticated() &&
        pid is string && pid != '' &&
        exists(pref) &&
        sent is string && sent.size() > 0 &&
        sent == get(pref).data.get('portalToken', '') &&
        resource.data.get('clinicId', '') ==
          get(pref).data.get('clinicId', '') &&
        notice is map &&
        notice.keys().hasOnly(['at', 'portalToken']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['avisoPagamento', 'updatedAt']);
    }
    match /financial/{docId} {
      allow update: if (isAuthenticated() &&
          clinicScoped(_docClinic(resource.data, request.resource.data))) ||
        _financialPortalNoticeOk();
    }

    // E. ANAMNESE ONLINE (P0 reavaliação: SEM leitura pública do prontuário).
    // Anônimo NUNCA lê (get/list negados); escreve SÓ com prova do token
    // DEDICADO `patients/{id}.anamnesisToken` (link `anamnese.html?id=&t=`).
    // Girar o token revoga links antigos. Equipe via clínica do paciente.
    function _anamProof() {
      let pid = request.resource.data.get('patientId', '');
      let pref = /databases/$(database)/documents/patients/$(pid);
      let sent = request.resource.data.get('proofToken', '');
      return pid is string && pid != '' && exists(pref) &&
        sent is string && sent.size() > 0 &&
        sent == get(pref).data.get('anamnesisToken', '');
    }
    function _anamFieldsOk(data, keys) {
      return keys.hasOnly(['patientId', 'proofToken', 'updatedAt',
          'underMedicalTreatment', 'medicalTreatmentDesc',
          'takingMedication', 'medicationDesc',
          'hasAllergies', 'allergiesDesc',
          'conditions', 'smoker', 'alcohol', 'bruxism', 'pregnant',
          'observations']) &&
        data.get('patientId', '') is string &&
        data.get('proofToken', '') is string &&
        data.get('underMedicalTreatment', false) is bool &&
        data.get('takingMedication', false) is bool &&
        data.get('hasAllergies', false) is bool &&
        data.get('smoker', false) is bool &&
        data.get('alcohol', false) is bool &&
        data.get('bruxism', false) is bool &&
        data.get('pregnant', false) is bool &&
        data.get('conditions', {}) is map &&
        data.get('medicalTreatmentDesc', '') is string &&
        data.get('medicalTreatmentDesc', '').size() < 500 &&
        data.get('medicationDesc', '') is string &&
        data.get('medicationDesc', '').size() < 500 &&
        data.get('allergiesDesc', '') is string &&
        data.get('allergiesDesc', '').size() < 500 &&
        data.get('observations', '') is string &&
        data.get('observations', '').size() < 2000;
    }
    match /anamnesis/{patientId} {
      allow get, list: if patientClinicOk(patientId);
      // Prova SÓ anônima (!auth): autenticado sem clínica usa o escopo
      // (sem piggyback do token persistido — reavaliação P1).
      allow create: if patientClinicOk(patientId) ||
        (!isAuthenticated() &&
         request.resource.data.get('patientId', '') == patientId &&
         _anamProof() && _anamFieldsOk(
          request.resource.data, request.resource.data.keys()));
      allow update: if patientClinicOk(patientId) ||
        (!isAuthenticated() &&
         request.resource.data.get('patientId', '') == patientId &&
         _anamProof() && _anamFieldsOk(request.resource.data,
          request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if patientClinicOk(patientId);
    }

    // F. DADOS OPERACIONAIS (escopo por clínica + clínica ativa; sem owner
    // global). Cura legados sem clinicId pelo campo novo no update/delete
    // (leitura de legado sem clínica = negada; base verificada com campo).
    match /{collection}/{docId} {
      allow read: if isAuthenticated() &&
          (collection in ['patients', 'appointments', 'financial', 'treatments', 'treatment_plans', 'budgets', 'clinical_records', 'psychology_schedules']) &&
          clinicScoped(resource.data.get('clinicId', ''));

      // request.resource não existe no delete; separar as permissões evita
      // evaluation error e usa sempre o clinicId armazenado no documento.
      allow update: if isAuthenticated() &&
          (collection in ['patients', 'appointments', 'financial', 'treatments', 'treatment_plans', 'budgets', 'clinical_records', 'psychology_schedules']) &&
          clinicScoped(_docClinic(resource.data, request.resource.data)) &&
          resource.data.get('clinicId', '') ==
            request.resource.data.get('clinicId', '');
      allow delete: if isAuthenticated() &&
          (collection in ['patients', 'appointments', 'financial', 'treatments', 'treatment_plans', 'budgets', 'clinical_records', 'psychology_schedules']) &&
          clinicScoped(resource.data.get('clinicId', ''));

      allow create: if isAuthenticated() &&
          (collection in ['patients', 'appointments', 'financial', 'treatments', 'treatment_plans', 'budgets', 'clinical_records', 'psychology_schedules']) &&
          clinicScoped(request.resource.data.clinicId);
    }

    // --- MÓDULO DE GESTÃO (escopo por clínica) ---
    // procedures: catálogo GLOBAL intencional (itens sem clinicId legíveis;
    // auditoria 16/10: sem dado particular — nome/preço/duração).
    // inventory/suppliers: clinicId OBRIGATÓRIO (base verificada em 16/10:
    // 0 + 12 docs, todos COM clinicId — sem legado).
    match /procedures/{document=**} {
      allow read: if isAuthenticated() && (isSuperAdmin() ||
          !('clinicId' in resource.data) ||
          clinicScoped(resource.data.get('clinicId', '')));
      allow create: if isSuperAdmin() ||
          (isAuthenticated() && 'clinicId' in request.resource.data &&
           clinicScoped(request.resource.data.get('clinicId', '')));
      allow update: if isSuperAdmin() ||
          (isAuthenticated() && 'clinicId' in resource.data &&
           'clinicId' in request.resource.data &&
           resource.data.get('clinicId', '') ==
             request.resource.data.get('clinicId', '') &&
           clinicScoped(resource.data.get('clinicId', '')));
      allow delete: if isSuperAdmin() ||
          (isAuthenticated() && 'clinicId' in resource.data &&
           clinicScoped(resource.data.get('clinicId', '')));
    }

    match /inventory/{document=**} {
      allow read: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow create: if isAuthenticated() &&
          clinicScoped(request.resource.data.get('clinicId', ''));
      allow update: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', '')) &&
          resource.data.get('clinicId', '') ==
            request.resource.data.get('clinicId', '') &&
          clinicScoped(request.resource.data.get('clinicId', ''));
      allow delete: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
    }

    match /suppliers/{document=**} {
      allow read: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow create: if isAuthenticated() &&
          clinicScoped(request.resource.data.get('clinicId', ''));
      allow update: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', '')) &&
          resource.data.get('clinicId', '') ==
            request.resource.data.get('clinicId', '') &&
          clinicScoped(request.resource.data.get('clinicId', ''));
      allow delete: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
    }

    // --- DESPESAS E LAB (escopo por clínica + ativa, espelha regra F) ---
    match /expenses/{docId} {
      allow read: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow update: if isAuthenticated() &&
          clinicScoped(_docClinic(resource.data, request.resource.data)) &&
          resource.data.get('clinicId', '') ==
            request.resource.data.get('clinicId', '');
      allow delete: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow create: if isAuthenticated() &&
          clinicScoped(request.resource.data.clinicId);
    }

    match /lab_orders/{orderId} {
      allow read: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow update: if isAuthenticated() &&
          clinicScoped(_docClinic(resource.data, request.resource.data)) &&
          resource.data.get('clinicId', '') ==
            request.resource.data.get('clinicId', '');
      allow delete: if isAuthenticated() &&
          clinicScoped(resource.data.get('clinicId', ''));
      allow create: if isAuthenticated() &&
          clinicScoped(request.resource.data.clinicId);
    }

    // (blocos plans/anticipations removidos — sem escritores/leitores no
    // app; sem regra, o acesso é negado por padrão.)

    // --- CONFIGURAÇÕES DA CLÍNICA (fees + integrations) ---
    // settings/*: leitura da EQUIPE da clínica (antes: qualquer
    // autenticado); escrita owner-da-clínica/superadmin fora de segredos.
    match /clinics/{clinicId}/settings/{document=**} {
      allow read: if isSuperAdmin() ||
          (_isActiveUser() && !isSecretsPath(document) &&
           (hasClinicAccess(clinicId) || ownsClinic(clinicId)));
      allow write: if isSuperAdmin() ||
          (_isActiveUser() && ownsClinic(clinicId) && clinicActive(clinicId) &&
           !isSecretsPath(document));
    }
    // Taxas da maquininha: leitura da equipe (card/fees + financeiro leem);
    // escrita dono-da-clínica/superadmin.
    match /clinics/{clinicId}/settings/fees/{doc=**} {
      allow read: if isSuperAdmin() || (_isActiveUser() &&
          (hasClinicAccess(clinicId) || ownsClinic(clinicId)));
      allow write: if isSuperAdmin() ||
          (_isActiveUser() && ownsClinic(clinicId) && clinicActive(clinicId));
    }
    // Segredos: SÓ dono DA clínica ou plataforma (antes: qualquer owner
    // global lia/escrevia segredos de qualquer clínica).
    match /clinics/{clinicId}/settings/integrations/{sub=**} {
      allow read, write: if isSuperAdmin() ||
          (_isActiveUser() && ownsClinic(clinicId) && clinicActive(clinicId));
    }

    // ---------------------------------------------------------
    // 3. SUBCOLEÇÕES (Odontograma, Prontuário dentro de Paciente)
    // ---------------------------------------------------------
    match /patients/{patientId}/{subcollection}/{docId} {
       allow read, write: if
          isAuthenticated() &&
          exists(/databases/$(database)/documents/patients/$(patientId)) &&
          patientClinicOk(patientId);
    }
  }
}
