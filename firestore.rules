rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES DE SEGURANÇA ---
    
    // Verifica se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Verifica se é a Dra. Lauciele (Super Admin)
    function isOwner() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    // 1b. Dono da plataforma (Master): gerencia owners, clínicas e débitos.
    function isSuperAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // 1c. Dono do débito da plataforma (owner da assinatura).
    function isPlatformDebtor(resource) {
      return isAuthenticated() &&
             resource.data.ownerId == request.auth.uid;
    }

    // 2. Verifica se a funcionária tem permissão para a clínica do documento
    function hasClinicAccess(clinicId) {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);

      return isAuthenticated() &&
             exists(userDocPath) &&
             get(userDocPath).data.allowedClinics != null &&
             (clinicId in get(userDocPath).data.allowedClinics);
    }

    // 3. Caminho de segredos dentro de settings (ex.: integrations/cloudinary)
    function isSecretsPath(document) {
      return document == 'integrations' || document.matches('integrations/.*');
    }

    // --- REGRAS DE COLEÇÕES ---

    // A. USUÁRIOS
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner() || isSuperAdmin();
      // Auto-cadastro (email/Google): o próprio usuário cria o doc,
      // sem clínica e sem poder virar owner (owner libera depois).
      allow create: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.role in
             ['dentist', 'dentista', 'receptionist', 'recepcionista', 'psicologo']
          && request.resource.data.allowedClinics == []
          && request.resource.data.status == 'pending_approval';
      // Trial com porteira: o próprio usuário cria o doc como owner
      // PENDENTE (sem clínica, sem trial). Superadmin aprova e provisiona.
      allow create: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.role == 'owner'
          && request.resource.data.allowedClinics == []
          && request.resource.data.status == 'pending_approval'
          && !('trialEndsAt' in request.resource.data.keys());
    }

    // A1b. PEDIDOS DE TRIAL (porteira do teste grátis). Create público com
    // allowlist; leitura/escrita só superadmin (vê no Master e aprova).
    match /trial_requests/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['nome', 'whatsapp', 'email', 'clinicName', 'type', 'status', 'createdAt'])
          && request.resource.data.status == 'solicitado'
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 1
          && request.resource.data.nome.size() < 100
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email.size() < 100;
      allow read, update, delete: if isSuperAdmin();
    }

    // A2. PREFERÊNCIAS DO USUÁRIO (ex.: tema) — o próprio usuário ou owner.
    match /user_prefs/{uid} {
      allow read, write: if isAuthenticated() &&
          (isOwner() || request.auth.uid == uid);
    }

    // A3. PEDIDOS DE RESET DE SENHA (sem e-mail automatico: e-mails
    // genericos nao tem caixa de entrada). Create PUBLICO (pedido feito
    // deslogado na tela de login, allowlist rigida); leitura, update e
    // delete SO owner. Staff nao le: o doc nao tem clinicId, entao o
    // hasClinicAccess do catch-all F retorna false.
    match /password_reset_requests/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['email', 'createdAt', 'status'])
          && request.resource.data.status == 'pending'
          && request.resource.data.email is string
          && request.resource.data.email.size() > 3
          && request.resource.data.email.size() < 100;
      allow read, update, delete: if isOwner();
    }

    // B. CLÍNICAS (trialEndsAt + blockedByAdmin: só superadmin escreve)
    // Operacional (pixKey/gradeConfig/whatsappNumber): staff da clínica
    // COM a flag g_pix/g_grade/g_clinica no mapa; resto segue owner.
    match /clinics/{clinicId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner() || isSuperAdmin();
      allow update: if isOwner() || isSuperAdmin() ||
        (hasClinicAccess(clinicId) && _clinicOpAllowed());
    }

    function _clinicOpAllowed() {
      let affected =
        request.resource.data.diff(resource.data).affectedKeys();
      let u = get(
        /databases/$(database)/documents/users/$(request.auth.uid)).data;
      let flags = 'menuAccess' in u ? u.menuAccess : {};
      return affected.hasOnly(
          ['pixKey', 'gradeConfig', 'whatsappNumber', 'updatedAt']) &&
        (!('pixKey' in affected) || flags['g_pix'] == true) &&
        (!('gradeConfig' in affected) || flags['g_grade'] == true) &&
        (!('whatsappNumber' in affected) || flags['g_clinica'] == true);
    }

    // B2. ASSINATURA DA PLATAFORMA (cobrança por usuário do owner).
    // platform_config/geral: {basePrice, extraPrice, pixKey}.
    match /platform_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    match /platform_debits/{debitId} {
      allow read: if isSuperAdmin() || isPlatformDebtor(resource);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isPlatformDebtor(resource) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['avisoPagamento', 'updatedAt']));
    }
    
    // C. NOTÍCIAS
    match /news/{newsId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // D. EXCEÇÃO: CONFIRMAÇÃO VIA WHATSAPP / PORTAL
    match /appointments/{appointmentId} {
      allow update: if 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 
'confirmationDate']) &&
        request.resource.data.status == 'Confirmado';
      // Portal: pedido de remarcação (vira pendência p/ recepção).
      // Leva a data proposta + token (o app interno lê tudo do agendamento).
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'proposedDate', 'portalToken']) &&
        request.resource.data.status == 'remarcar';
    }

    // A4. PORTAL DO PACIENTE (espelhos; sem Functions).
    // portal/{token}: get público (doc opaco, só com o link); escrita sem
    // login SOMENTE via allowlist (pedidos do paciente); create/delete e
    // demais escritas: autenticado (o app escreve via syncPortalMirror).
    // portal_slots/{clinicId}: get público (só horários livres, sem dado
    // de paciente); escrita só autenticado (app mantém via arrayUnion).
    match /portal/{token} {
      allow get: if true;
      allow create, delete: if isAuthenticated();
      allow update: if isAuthenticated() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'statusSessao', 'pedidoRemarcacao', 'avisoPagamento', 'updatedAt'
        ]);
    }
    match /portal_slots/{clinicId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Portal: "avisei que paguei" (selo p/ tesouraria dar baixa ou dispensar).
    match /financial/{docId} {
      allow update: if isAuthenticated() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['avisoPagamento', 'updatedAt']);
    }

    // E. ANAMNESE ONLINE
    // get público: prefill do anamnese.html (sem login).
    // Escrita pública RESTRITA aos 14 campos do formulário (allowlist);
    // staff autenticado mantém acesso total (prontuário no app).
    match /anamnesis/{patientId} {
      allow get: if true;
      allow delete: if isAuthenticated();
      allow create: if isAuthenticated() || request.resource.data.keys().hasOnly([
        'patientId', 'updatedAt',
        'underMedicalTreatment', 'medicalTreatmentDesc',
        'takingMedication', 'medicationDesc',
        'hasAllergies', 'allergiesDesc',
        'conditions', 'smoker', 'alcohol', 'bruxism', 'pregnant',
        'observations'
      ]);
      allow update: if isAuthenticated() || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'patientId', 'updatedAt',
        'underMedicalTreatment', 'medicalTreatmentDesc',
        'takingMedication', 'medicationDesc',
        'hasAllergies', 'allergiesDesc',
        'conditions', 'smoker', 'alcohol', 'bruxism', 'pregnant',
        'observations'
      ]);
    }

    // F. DADOS OPERACIONAIS (CORREÇÃO DE ACESSO PARA FUNCIONÁRIOS)
    match /{collection}/{docId} {
      allow read, update, delete: if 
          isAuthenticated() &&
          (collection in ['patients', 'appointments', 'financial', 'treatments', 'treatment_plans', 'budgets', 'clinical_records', 'psychology_schedules']) &&
          (isOwner() || hasClinicAccess(resource.data.clinicId));
      
      allow create: if 
          isAuthenticated() &&
          (collection in ['patients', 'appointments', 'financial', 'treatments', 'treatment_plans', 'budgets', 'clinical_records', 'psychology_schedules']) &&
          (isOwner() || hasClinicAccess(request.resource.data.clinicId));
    }

    // --- MÓDULO DE GESTÃO (mantido amplo DE PROPÓSITO) ---
    // procedures = catálogo global sem clinicId; inventory/suppliers têm
    // leitores legados sem filtro (product_service). Escopar aqui quebraria
    // telas de staff — ver Apêndice B dos Requisitos.
    match /procedures/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /inventory/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /suppliers/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // --- DESPESAS E LAB (escopo por clínica, espelha regra F) ---
    // Todas as leituras do app filtram por clinicId e todos os creates
    // gravam clinicId (verificado em expense_service, reports, fin_tab,
    // lab_service, patient_lab_tab). Queries sem clinicId serão negadas.
    match /expenses/{docId} {
      allow read, update, delete: if isAuthenticated() &&
          (isOwner() || hasClinicAccess(resource.data.clinicId));
      allow create: if isAuthenticated() &&
          (isOwner() || hasClinicAccess(request.resource.data.clinicId));
    }

    match /lab_orders/{orderId} {
      allow read, update, delete: if isAuthenticated() &&
          (isOwner() || hasClinicAccess(resource.data.clinicId));
      allow create: if isAuthenticated() &&
          (isOwner() || hasClinicAccess(request.resource.data.clinicId));
    }

    // (blocos plans/anticipations removidos — ver nota abaixo)

    // REMOVIDOS os blocos amplos de financial/treatments/treatment_plans:
    // redundantes com a regra F (já exige owner OU acesso à clínica) e
    // apenas alargavam o acesso. Sem eles, vale a regra F.

    // REMOVIDOS `plans/**` e `anticipations/**`: sem escritores/leitores
    // no app (verificado) — sem regra, o acesso é negado por padrão.
    
    // --- CONFIGURAÇÕES DA CLÍNICA (fees + integrations) ---
    // settings/*: leitura p/ qualquer autenticado (telas leem perfil de
    // taxas), escrita SÓ owner.
    // settings/integrations/**: SÓ owner (higiene p/ segredos futuros;
    // plano Spark não tem backend — nada no app lê este caminho hoje).
    match /clinics/{clinicId}/settings/{document=**} {
      allow read: if isAuthenticated() && !isSecretsPath(document);
      allow write: if isOwner() && !isSecretsPath(document);
    }
    match /clinics/{clinicId}/settings/integrations/{sub=**} {
      allow read, write: if isOwner();
    }
    
    // ---------------------------------------------------------
    // 3. SUBCOLEÇÕES (Odontograma, Prontuário dentro de Paciente)
    // ---------------------------------------------------------
    match /patients/{patientId}/{subcollection}/{docId} {
       allow read, write: if 
          isAuthenticated() &&
          exists(/databases/$(database)/documents/patients/$(patientId)) &&
          (isOwner() || hasClinicAccess(get(/databases/$(database)/documents/patients/$(patientId)).data.clinicId));
    }
  }
}